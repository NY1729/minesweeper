PORT=8080
WORLD_ID=main
WORLD_SEED=replace-with-a-long-random-secret
MINE_PERMILLE=160
FLUSH_INTERVAL_SECONDS=2
# The game database is a SQLite file in the `data` docker volume (set by compose.yml:
# DATABASE_PATH=/data/minesweeper.db). Nothing to configure here.
#
# Only needed once, to copy the old Turso data over: docker compose run --rm --no-deps backend -import-turso
# TURSO_DATABASE_URL=https://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token
ALLOWED_ORIGINS=http://localhost:5173,https://mine.example.com
# Simultaneous websockets allowed from one client IP (people behind one NAT share it). Default 20.
# MAX_CONNS_PER_IP=20
